    "react": "19.1.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.1.0",
    "react-in-viewport": "^1.0.0-beta.8",
    "react-material-ui-carousel": "https://github.com/haziqfaceki/react-material-ui-carousel/tarball/master",
